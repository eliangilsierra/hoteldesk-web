# HotelDesk currently runs entirely client-side with mock data generated by Faker.
# No environment variables are required to run the app today.
#
# The variables below are placeholders for when the mock data layer
# (src/lib/stores/data-store.ts) is swapped for a real backend.
# See docs/decisions.md for the reasoning behind this boundary.

# Base URL of the HotelDesk API, once one exists.
# VITE_API_BASE_URL=https://api.example.com
